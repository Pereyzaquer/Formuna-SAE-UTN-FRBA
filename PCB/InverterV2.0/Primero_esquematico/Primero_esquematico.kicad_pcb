	(gr_text "Nicolas Pereyra\nAgustin Giovanazzi"
		(at 208.35 33.25 0)
		(layer "F.SilkS")
		(uuid "9bff5a03-2e0d-4dc7-92c0-489ba908c036")
		(effects
