	)
	(text "Vout=5V\nVd = 0,4V (Esto hay q probarlo porque varia un poco este dato)\nNps = 3\nRset = 12k1\nVref = 1,21V\n"
		(exclude_from_sim no)
		(at 82.296 135.382 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0c8cf7df-c18d-426c-9f0b-ddf49be5ef7f")
	)
	(text "Rtc = 105k\nValor Comercial -> 110k"
		(exclude_from_sim no)
		(at 200.152 140.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
