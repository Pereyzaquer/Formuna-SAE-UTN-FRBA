	)
	(text "Circuito basado en el LM25180-Q1"
		(exclude_from_sim no)
		(at 58.166 49.276 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5c690989-e4bb-4110-be0f-0e1ba424f7e6")
	)
	(text "El dato de TCdiodo no me lo da pero lo calculo con el resto de los datos\n(D de Delta)\nDVf = 0,63V-0,78V=-0,15V\nDT = 125C-25C=100\nTc = DVf/DT = 1,5mV/°C"
		(exclude_from_sim no)
		(at 201.93 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a89d6d48-21c3-430c-a8f6-df8981bee60a")
	)
	(text "Recalcular en caso de usar otra fuente\n(En este caso se utilizaron fuente de 15V)\nVin(on) = 14V\nVin(off) = 12V"
		(exclude_from_sim no)
		(at 68.072 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b467346c-faf7-4b55-bf25-c5cd7aeb4ea1")
	)
