
(rules PCB freerouting.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
  )
  (padstack "Via[0-5]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In1.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In2.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In3.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle In4.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-5]_600:300_um" "Via[0-5]_600:300_um" default
  )
  (via 
    "Via[0-5]_600:300_um-kicad_default" "Via[0-5]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-5]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-5]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu In1.Cu In2.Cu In3.Cu In4.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "GND_Can_1" "/pcb_potencia/Gate_Driver/ISO_HS_GND" "GNDPWR_2" "GNDPWR_3" "GND_Can_2" "GNDPWR_1" "/pcb_potencia/Gate_Driver/GD_HS_2/ISO_GND" "/pcb_potencia/Gate_Driver/GD_HS_3/ISO_GND"
