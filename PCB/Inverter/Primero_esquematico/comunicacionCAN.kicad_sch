	(text "Uso de la resistencia de 120 Ohms"
		(exclude_from_sim no)
		(at 193.802 86.868 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.3556)
				(bold yes)
			)
		)
		(uuid "212a8859-085a-44ef-832c-9d5cfcc3f224")
	)
	(text "La utilizacion de la resitencia de 120 Ohms es para adaptar la linea\nesto sirve para velocidades de conmutacion rapidas y es valida\ncuando el cable que se utiliza tiene una impedancia caracteristica de\n120 Ohms. En caso de que no se cumpla eso la linea estara desadaptada \ny la funcion de la resistencia no tendra mucho sentido. Si se utiliza\nun CAN paracomunicar muchos nodos tampoco tiene sentido la resistencia\nde 120 Ohms. Para ambos casos se tendra que remover"
		(exclude_from_sim no)
		(at 194.056 98.044 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "74a5e810-1702-42c2-9e7c-559829189816")
	)
	(text "Estos transreciver son una version grande se podrian achicar a la mitad.\nElegi estos porque ya los compre pero se pueden comprar nuevos"
		(exclude_from_sim no)
		(at 144.526 23.622 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "f992a111-52ef-49bd-a459-0bee79d9b365")
	)
