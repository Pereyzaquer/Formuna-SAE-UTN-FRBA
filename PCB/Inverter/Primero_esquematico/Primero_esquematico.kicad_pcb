	(gr_text "IPC‑2221, ΔT = 20 °C\n1 -> Layer: 2 oz\n"
		(locked yes)
		(at 245 44 0)
		(layer "User.1")
		(uuid "1639aa4c-40ab-4865-a530-1dc2ec08b511")
		(effects
			(font
				(size 2 2)
				(thickness 0.3)
			)
			(justify left bottom)
		)
	)
	(gr_text "1) Top - componentes; rutas cortas de gate y HV (con su clearance) en la zona caliente, MCU/digital en la zona fría.\n2) GND - plano de masa sólido del lado control; del lado caliente, este nivel lleva GNDPWR y las masas secundarias flotantes (separadas por la ranura).\n3) Señal - digital (PWM, SPI, GPIO) referenciada al plano de L2.\n4) PWR - 3.3V/5V/12V del lado frío; islas +15V_ISO / +5V_ISO del lado caliente.\n5) GND - segunda referencia, para la L6.\n6) Bottom - sensado analógico y ruteo restante."
		(locked yes)
		(at 245.6 67.9 0)
		(layer "User.3")
		(uuid "5d02d682-f77a-4733-8114-6cbc004ba306")
		(effects
			(font
				(size 2 2)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "Normas FSAE a seguir:\n- EV.6.5.7\n- EV.6.5.5\n- EV.6.5\n- EV.6.4.3\n- EV.5\n- EV.7\n- EV.4\n\nNormas para pistas y otras cosas:\n- IPC-2221\n- IPC-2152\n- IPC-6012\n- IPC-A-600\n- IPC-A-610\n- IPC-CC-830\n- IEC 60664-1\n- ISO 6469"
		(locked yes)
		(at 246.24 129.82 0)
